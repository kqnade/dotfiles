#!/usr/bin/env bash

set -euo pipefail

config=$(cat)
expression='
  .defaultProvider = "openai-codex" |
  .defaultModel = "gpt-5.6-sol" |
  .defaultThinkingLevel = "xhigh" |
  .modelThinkingLevels."openai-codex/gpt-5.6-sol" = "xhigh"
'

if [[ -n "$config" ]]; then
  printf '%s\n' "$config" | yq -p json -o json "$expression"
else
  yq -n -p json -o json "$expression"
fi
