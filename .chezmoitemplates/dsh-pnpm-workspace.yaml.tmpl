{{- $version := (index (include "mise.toml" | fromToml).tools "npm:@deepseek-ai/dsh").version -}}
{{- if eq .role "work" }}
overrides:
  '@deepseek-ai/dsh-subagent-claude-code>@anthropic-ai/claude-agent-sdk': 0.3.309
{{- end }}
{{- if or (eq .role "personal") (eq .surface "tui") }}
patchedDependencies:
{{- if eq .role "personal" }}
  '@deepseek-ai/dsh-experimental-auto-review@{{ $version }}': ../../../patches/dsh-auto-review.patch
{{- end }}
{{- if eq .surface "tui" }}
  '@deepseek-ai/dsh@{{ $version }}': ../../../patches/dsh-shutdown.patch
{{- end }}
{{- end }}
allowBuilds:
  '@deepseek-ai/dsh-subprocess-local': true
  '@google/genai': false
  koffi: true
  node-pty: true
  protobufjs: false
