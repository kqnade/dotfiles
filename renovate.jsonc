{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],

  // 通常の機能追加・修正更新は、リリースから1日経過後にPR化する。
  "minimumReleaseAge": "1 day",

  // Renovateの各巡回時に、時刻を制限せず更新PRを作成する。
  "timezone": "Asia/Tokyo",
  "schedule": [
    "at any time"
  ],

  // 脆弱性更新は待たずにPR化する。
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null
  },
  "osvVulnerabilityAlerts": true,

  "reviewersFromCodeOwners": true,

  // CI、ローカル bootstrap、lock 更新が同じ mise を使う。
  "constraints": {
    "mise": "2026.11.13"
  },

  // Approveと必須CIの成功後、GitHubのnative auto-mergeでsquashする。
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,

  "lockFileMaintenance": {
    "enabled": true
  },

  "customDatasources": {
    "onepassword-cli": {
      "defaultRegistryUrlTemplate": "https://mise-versions.jdx.dev/1password-cli",
      "format": "plain"
    },
    "mise-linux-x64": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/jdx/mise/releases?per_page=100",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": $filter($map($filter($, function($v) { $count($filter($v.assets, function($a) { $a.name = \"mise-\" & $v.tag_name & \"-linux-x64\" })) > 0 and $v.prerelease = false and $v.draft = false }), function($v) {( $asset := $filter($v.assets, function($a) { $a.name = \"mise-\" & $v.tag_name & \"-linux-x64\" })[0]; { \"version\": $replace($v.tag_name, /^v/, \"\"), \"digest\": $replace($asset.digest, /^sha256:/, \"\"), \"releaseTimestamp\": $v.published_at, \"sourceUrl\": \"https://github.com/jdx/mise\", \"isStable\": true } )}), function($r) { $length($r.digest) = 64 and $contains($r.version, /^\\d+\\.\\d+\\.\\d+$/) }), \"sourceUrl\": \"https://github.com/jdx/mise\" }"
      ]
    },
    "mise-macos-arm64": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/jdx/mise/releases?per_page=100",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": $filter($map($filter($, function($v) { $count($filter($v.assets, function($a) { $a.name = \"mise-\" & $v.tag_name & \"-macos-arm64\" })) > 0 and $v.prerelease = false and $v.draft = false }), function($v) {( $asset := $filter($v.assets, function($a) { $a.name = \"mise-\" & $v.tag_name & \"-macos-arm64\" })[0]; { \"version\": $replace($v.tag_name, /^v/, \"\"), \"digest\": $replace($asset.digest, /^sha256:/, \"\"), \"releaseTimestamp\": $v.published_at, \"sourceUrl\": \"https://github.com/jdx/mise\", \"isStable\": true } )}), function($r) { $length($r.digest) = 64 and $contains($r.version, /^\\d+\\.\\d+\\.\\d+$/) }), \"sourceUrl\": \"https://github.com/jdx/mise\" }"
      ]
    },
    "mise-macos-x64": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/jdx/mise/releases?per_page=100",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": $filter($map($filter($, function($v) { $count($filter($v.assets, function($a) { $a.name = \"mise-\" & $v.tag_name & \"-macos-x64\" })) > 0 and $v.prerelease = false and $v.draft = false }), function($v) {( $asset := $filter($v.assets, function($a) { $a.name = \"mise-\" & $v.tag_name & \"-macos-x64\" })[0]; { \"version\": $replace($v.tag_name, /^v/, \"\"), \"digest\": $replace($asset.digest, /^sha256:/, \"\"), \"releaseTimestamp\": $v.published_at, \"sourceUrl\": \"https://github.com/jdx/mise\", \"isStable\": true } )}), function($r) { $length($r.digest) = 64 and $contains($r.version, /^\\d+\\.\\d+\\.\\d+$/) }), \"sourceUrl\": \"https://github.com/jdx/mise\" }"
      ]
    }
  },

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^mise\\.(toml|lock)$/"
      ],
      "matchStrings": [
        "\"cargo:https://github\\.com/wachikun/yaskkserv2\"\\s*=\\s*\\{\\s*version\\s*=\\s*\"rev:(?<currentDigest>[a-f0-9]{40})\"",
        "\\[\\[tools\\.\"cargo:https://github\\.com/wachikun/yaskkserv2\"\\]\\]\\s*version\\s*=\\s*\"rev:(?<currentDigest>[a-f0-9]{40})\""
      ],
      "depNameTemplate": "wachikun/yaskkserv2",
      "packageNameTemplate": "wachikun/yaskkserv2",
      "datasourceTemplate": "github-digest",
      "currentValueTemplate": "master",
      "versioningTemplate": "exact"
    },
    {
      "customType": "regex",
      "description": "Track the mise release used by CI, bootstrap, and Renovate.",
      "managerFilePatterns": [
        "/^install\\.sh$/",
        "/^mise\\.toml$/",
        "/^renovate\\.jsonc$/"
      ],
      "matchStrings": [
        "readonly MISE_MIN_VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "(?:^|\\n)min_version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "\"mise\": \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "jdx/mise",
      "packageNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Linux mise asset checksum with its release.",
      "managerFilePatterns": [
        "/^install\\.sh$/"
      ],
      "matchStrings": [
        "readonly MISE_LINUX_X64_VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"\\nreadonly MISE_LINUX_X64_SHA256=\"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "depNameTemplate": "jdx/mise-linux-x64",
      "packageNameTemplate": "linux-x64",
      "datasourceTemplate": "custom.mise-linux-x64",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Apple Silicon mise asset checksum with its release.",
      "managerFilePatterns": [
        "/^install\\.sh$/"
      ],
      "matchStrings": [
        "readonly MISE_MACOS_ARM64_VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"\\nreadonly MISE_MACOS_ARM64_SHA256=\"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "depNameTemplate": "jdx/mise-macos-arm64",
      "packageNameTemplate": "macos-arm64",
      "datasourceTemplate": "custom.mise-macos-arm64",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Intel macOS mise asset checksum with its release.",
      "managerFilePatterns": [
        "/^install\\.sh$/"
      ],
      "matchStrings": [
        "readonly MISE_MACOS_X64_VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"\\nreadonly MISE_MACOS_X64_SHA256=\"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "depNameTemplate": "jdx/mise-macos-x64",
      "packageNameTemplate": "macos-x64",
      "datasourceTemplate": "custom.mise-macos-x64",
      "versioningTemplate": "semver"
    }
  ],

  "packageRules": [
    {
      "description": "Move CI, bootstrap, and Renovate onto the newest stable mise release together.",
      "matchPackageNames": [
        "jdx/mise",
        "jdx/mise-linux-x64",
        "jdx/mise-macos-arm64",
        "jdx/mise-macos-x64"
      ],
      "groupName": "mise",
      "groupSlug": "mise",
      "minimumReleaseAge": null,
      "commitMessageTopic": "mise"
    },
    {
      "description": "Track stable 1Password CLI releases through mise's version endpoint because the aqua registry package has no resolvable upstream repository.",
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "1password/cli"
      ],
      "overrideDatasource": "custom.onepassword-cli",
      "versioning": "semver",
      "minimumReleaseAge": null
    },
    {
      "description": "Keep GitHub binary versions consistent with mise's unprefixed lockfile entries.",
      "matchManagers": [
        "mise"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "pnpm/pnpm",
        "atuinsh/atuin"
      ],
      "extractVersion": "^v?(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioning": "semver"
    },
    {
      "description": "Assign yaskkserv2 revision updates to the master digest manager.",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "cargo:https://github.com/wachikun/yaskkserv2"
      ],
      "enabled": false
    },
    {
      "description": "Track AI coding tool releases without the default release cooldown.",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "claude",
        "cursor-agent",
        "herdr"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Create security PRs immediately, bypassing the default 1-day release age.",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "matchJsonata": [
        "$exists(vulnerabilityFixVersion) or isVulnerabilityAlert"
      ],
      "minimumReleaseAge": null,
      "prCreation": "immediate"
    },
    {
      "description": "Prefer immutable Docker digest pins where Renovate supports them. Docker keeps the readable tag as image:1.2.3@sha256:...; GitHub Actions use helpers:pinGitHubActionDigestsToSemver for action@sha # v1.2.3.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Keep the Fedora CI container on numbered release tags instead of latest or rawhide.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "fedora"
      ],
      "allowedVersions": "/^\\d+$/"
    }
  ]
}
