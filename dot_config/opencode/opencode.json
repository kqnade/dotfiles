{
  "$schema": "https://opencode.ai/config.json",

  "model": "kimi/KimiK2.7Code",

  "autoupdate": false,

  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "secrets/**": "deny",
      "**/secrets/**": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.key": "deny",
      "**/*.key": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "secrets/**": "deny",
      "**/secrets/**": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.key": "deny",
      "**/*.key": "deny"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git grep *": "allow",
      "git blame *": "allow",
      "git branch --show-current": "allow",
      "git branch --list": "allow",
      "git branch --list *": "allow",
      "git remote -v": "allow",
      "git remote get-url *": "allow",
      "git tag --list": "allow",
      "git tag --list *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "cargo *": "allow",
      "go *": "allow",
      "zig *": "allow",
      "npm *": "allow",
      "rm": "ask",
      "rm *": "ask",
      "rmdir": "ask",
      "rmdir *": "ask",
      "git -c": "ask",
      "git -c *": "ask",
      "git add .": "ask",
      "git add -A": "ask",
      "git add -A *": "ask",
      "git add --all": "ask",
      "git add --all *": "ask",
      "git add -u": "ask",
      "git add -u *": "ask",
      "git commit --amend": "ask",
      "git commit --amend *": "ask",
      "git commit -a": "ask",
      "git commit -a *": "ask",
      "git commit -a*": "ask",
      "git commit --all": "ask",
      "git commit --all *": "ask",
      "git reset": "ask",
      "git reset *": "ask",
      "git clean": "ask",
      "git clean *": "ask",
      "git restore": "ask",
      "git restore *": "ask",
      "git checkout --": "ask",
      "git checkout -- *": "ask",
      "git branch -D *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git lfs push *": "ask",
      "git lfs lock *": "ask",
      "git lfs unlock *": "ask",
      "git send-email *": "ask",
      "git svn dcommit *": "ask",
      "git p4 submit *": "ask",
      "npm publish": "ask",
      "npm publish *": "ask",
      "npm unpublish": "ask",
      "npm unpublish *": "ask",
      "npm deprecate *": "ask",
      "npm dist-tag *": "ask",
      "npm owner *": "ask",
      "npm access *": "ask",
      "npm token *": "ask",
      "npm login": "ask",
      "npm login *": "ask",
      "npm logout": "ask",
      "npm logout *": "ask",
      "npm adduser": "ask",
      "npm adduser *": "ask",
      "npm config set *": "ask",
      "npm install -g *": "ask",
      "npm install --global *": "ask",
      "cargo publish": "ask",
      "cargo publish *": "ask",
      "cargo yank *": "ask",
      "cargo owner *": "ask",
      "cargo login": "ask",
      "cargo login *": "ask",
      "cargo install *": "ask",
      "cargo uninstall *": "ask",
      "go env -w *": "ask",
      "go install *": "ask",
      "rm -rf": "deny",
      "rm -rf *": "deny",
      "git push --force": "deny",
      "git push --force *": "deny",
      "git push --force-with-lease": "deny",
      "git push --force-with-lease *": "deny",
      "git push -f": "deny",
      "git push -f *": "deny"
    }
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".next/**",
      "target/**",
      "coverage/**"
    ]
  },

  "instructions": [
    ".cursor/rules/*.md"
  ],

  "lsp": {
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash", ".zsh"]
    },
    "clojure": {
      "command": ["clojure-lsp"],
      "extensions": [".clj", ".cljs", ".cljc", ".edn"]
    },
    "cpp": {
      "command": ["clangd"],
      "extensions": [".c", ".cpp", ".cc", ".cxx", ".h", ".hpp", ".hxx"]
    },
    "csharp": {
      "command": ["omnisharp"],
      "extensions": [".cs", ".csx"]
    },
    "css": {
      "command": ["vscode-css-language-server", "--stdio"],
      "extensions": [".css", ".scss", ".less"]
    },
    "dockerfile": {
      "command": ["docker-langserver", "--stdio"],
      "extensions": [".dockerfile"]
    },
    "go": {
      "command": ["gopls"],
      "extensions": [".go"]
    },
    "html": {
      "command": ["vscode-html-language-server", "--stdio"],
      "extensions": [".html", ".htm"]
    },
    "java": {
      "command": ["jdtls"],
      "extensions": [".java"]
    },
    "javascript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".js", ".jsx", ".mjs", ".cjs"]
    },
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json"]
    },
    "jsonc": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".jsonc"]
    },
    "kotlin": {
      "command": ["kotlin-language-server"],
      "extensions": [".kt", ".kts"]
    },
    "lua": {
      "command": ["lua-language-server"],
      "extensions": [".lua"]
    },
    "powershell": {
      "command": ["powershell-editor-services", "--stdio"],
      "extensions": [".ps1", ".psm1", ".psd1"]
    },
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    },
    "ruby": {
      "command": ["ruby-lsp"],
      "extensions": [".rb", ".rake", ".gemspec"]
    },
    "rust": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"]
    },
    "tailwindcss": {
      "command": ["tailwindcss-language-server", "--stdio"],
      "extensions": [".css", ".html", ".jsx", ".tsx", ".vue"]
    },
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".mts", ".cts"]
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"]
    }
  }
}
