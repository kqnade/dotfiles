#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: todo-obligation register --expect HASH TASK_KEY --id ID --owner OWNER --policy POLICY (--destination .dev/PATH | --no-save-reason REASON)" >&2
  echo "       todo-obligation close --expect HASH TASK_KEY --id ID (--artifact .dev/PATH | --no-save-reason REASON)" >&2
  echo "       todo-obligation check TASK_KEY" >&2
  exit 2
}

is_safe_path() {
  [[ "$1" =~ ^[-A-Za-z0-9._/]+$ ]]
}

validate_artifact_evidence() {
  local owner=$1
  local destination=$2
  local artifact_target=$3
  local expected_target
  local current_worktree
  local walk_path
  local remaining
  local segment

  if ! is_safe_path "$destination"; then
    echo "todo-obligation: destination contains unsafe path characters" >&2
    return 1
  fi
  case "$destination" in
    .dev/adr/*|.dev/contexts/*|.dev/designdoc/*|.dev/research/*|.dev/memory/*|.dev/security/*) ;;
    *)
      echo "todo-obligation: destination must be under a canonical .dev area: $destination" >&2
      return 1
      ;;
  esac

  remaining=$destination
  while [[ "$remaining" == */* ]]; do
    segment=${remaining%%/*}
    remaining=${remaining#*/}
    if [[ -z "$segment" || "$segment" == "." || "$segment" == ".." ]]; then
      echo "todo-obligation: destination contains an invalid path segment: $destination" >&2
      return 1
    fi
  done
  if [[ -z "$remaining" || "$remaining" == "." || "$remaining" == ".." ]]; then
    echo "todo-obligation: destination contains an invalid path segment: $destination" >&2
    return 1
  fi

  case "$owner" in
    security-audit)
      [[ "$destination" == .dev/security/* ]] || {
        echo "todo-obligation: security-audit destinations must be under .dev/security/" >&2
        return 1
      }
      ;;
    context-handoff)
      [[ "$destination" == .dev/contexts/* ]] || {
        echo "todo-obligation: $owner destinations must be under .dev/contexts/" >&2
        return 1
      }
      ;;
  esac

  expected_target="../${destination#.dev/}"
  if [[ "$artifact_target" != "$expected_target" ]]; then
    echo "todo-obligation: Artifact link target must match Destination: $artifact_target" >&2
    return 1
  fi
  if ! is_safe_path "$artifact_target"; then
    echo "todo-obligation: Artifact link target contains unsafe path characters" >&2
    return 1
  fi

  current_worktree=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "todo-obligation: not inside a Git worktree" >&2
    return 1
  }
  current_worktree=$(cd "$current_worktree" && pwd -P)
  walk_path=$current_worktree
  remaining=$destination
  while [[ "$remaining" == */* ]]; do
    segment=${remaining%%/*}
    remaining=${remaining#*/}
    walk_path="$walk_path/$segment"
    if [[ -L "$walk_path" ]]; then
      echo "todo-obligation: artifact path must not traverse a symlink: $destination" >&2
      return 1
    fi
  done
  walk_path="$walk_path/$remaining"
  if [[ -L "$walk_path" || ! -f "$walk_path" ]]; then
    echo "todo-obligation: Artifact must be an existing regular non-symlink file: $destination" >&2
    return 1
  fi
}

check_obligations() {
  [[ $# -eq 1 ]] || usage
  local task_key=$1
  local script_dir
  local target
  local parsed
  local owner
  local destination
  local artifact_target

  script_dir=$(cd "$(dirname "$0")" && pwd -P)
  if ! target=$("$script_dir/todo-path" "$task_key"); then
    return 1
  fi
  if [[ -L "$target" || ! -f "$target" ]]; then
    echo "todo-obligation: active TODO must be a regular file: $target" >&2
    return 1
  fi

  if ! parsed=$(awk '
function fail(message) {
  print "todo-obligation: " message > "/dev/stderr"
  failed = 1
  exit 1
}

function canonical_pair(owner, policy) {
  return (owner == "security-audit" && policy == "required") ||
    (owner == "execute-worktree-implementation" && policy == "none") ||
    (owner == "test-driven-development" && policy == "none") ||
    (owner == "context-handoff" && policy == "conditional") ||
    (owner == "assumption-pruning" && policy == "none") ||
    (owner == "route-large-implementation" && policy == "none") ||
    (owner == "evidence-review" && policy == "none") ||
    (owner == "prose-proofreading" && policy == "none") ||
    (owner == "peer-consultation" && policy == "none") ||
    (owner == "herdr" && policy == "none")
}

function artifact_target(value,    rest, separator, label, target) {
  rest = substr(value, length("- Artifact: ") + 1)
  if (substr(rest, 1, 1) != "[") {
    fail("Artifact must be a Markdown link with a nonempty safe label")
  }
  separator = index(rest, "](")
  if (separator <= 2 || substr(rest, length(rest), 1) != ")") {
    fail("Artifact must be a Markdown link with a nonempty safe label")
  }
  label = substr(rest, 2, separator - 2)
  target = substr(rest, separator + 2, length(rest) - separator - 2)
  if (label !~ /[^[:space:]]/ || index(label, "[") || index(label, "]") || index(label, "\r")) {
    fail("Artifact must have a nonempty safe label")
  }
  if (target == "") {
    fail("Artifact must have a nonempty link target")
  }
  return target
}

function validate_reason(value,    reason, trimmed, lower) {
  reason = substr(value, length("- No-save reason: ") + 1)
  if (index(reason, "\r") || reason !~ /[^[:space:]]/) {
    fail("No-save reason must contain non-whitespace text")
  }
  trimmed = reason
  sub(/^[[:space:]]+/, "", trimmed)
  sub(/[[:space:]]+$/, "", trimmed)
  lower = tolower(trimmed)
  if (lower == "n/a" || lower == "na" || lower == "none" || lower == "null" ||
      lower == "nil" || lower == "tbd" || lower == "todo" || lower == "no reason" ||
      lower == "not applicable" || lower == "なし" || lower == "特になし") {
    fail("No-save reason must be concrete")
  }
}

function validate_block(start, end,    heading, id, count, i, line, owner_line,
                        policy_line, state_line, destination_line, owner, policy,
                        state, destination, target) {
  heading = lines[start]
  if (heading !~ /^### `[a-z0-9][a-z0-9._-]*`$/) {
    fail("Persistence obligations contains a non-canonical obligation heading")
  }
  id = heading
  sub(/^### `/, "", id)
  sub(/`$/, "", id)
  if (seen_ids[id]) {
    fail("Persistence obligations contains duplicate obligation ID: " id)
  }
  seen_ids[id] = 1

  count = 0
  for (i = start + 1; i < end; i++) {
    line = lines[i]
    if (line !~ /[^[:space:]]/) {
      continue
    }
    count++
    fields[count] = line
  }
  if (count < 4 || count > 5) {
    fail("obligation block must contain only its canonical fields")
  }
  owner_line = fields[1]
  policy_line = fields[2]
  state_line = fields[3]
  destination_line = fields[4]
  if (owner_line !~ /^- Owner: `[^`]+`$/ || policy_line !~ /^- Policy: `[^`]+`$/ ||
      state_line !~ /^- State: `[^`]+`$/) {
    fail("obligation block must use canonical Owner, Policy, and State fields")
  }
  owner = owner_line
  sub(/^- Owner: `/, "", owner)
  sub(/`$/, "", owner)
  policy = policy_line
  sub(/^- Policy: `/, "", policy)
  sub(/`$/, "", policy)
  state = state_line
  sub(/^- State: `/, "", state)
  sub(/`$/, "", state)
  if (!canonical_pair(owner, policy)) {
    fail("obligation block has a non-canonical owner-policy pair")
  }
  if (state != "open" && state != "closed") {
    fail("obligation block has an invalid State")
  }

  if (state == "open") {
    if (count != 4 || destination_line !~ /^- Destination: `[^`]+`$/ || policy == "none") {
      fail("open obligation must use canonical Owner, Policy, State, and Destination fields")
    }
    fail("persistence obligation is still open: " id)
  }

  if (destination_line ~ /^- Destination: `[^`]+`$/) {
    if (count != 5 || fields[5] !~ /^- Artifact: \[/) {
      fail("closed artifact obligation must contain Destination followed by Artifact")
    }
    if (policy != "required" && policy != "conditional") {
      fail("none obligations cannot close with an Artifact")
    }
    destination = destination_line
    sub(/^- Destination: `/, "", destination)
    sub(/`$/, "", destination)
    target = artifact_target(fields[5])
    print owner "\t" destination "\t" target
    return
  }

  if (destination_line ~ /^- No-save reason: /) {
    if (count != 4) {
      fail("closed no-save obligation must contain exactly Owner, Policy, State, and No-save reason")
    }
    if (policy != "conditional" && policy != "none") {
      fail("required obligations cannot close with a No-save reason")
    }
    validate_reason(destination_line)
    return
  }
  fail("closed obligation must contain exactly one canonical Destination/Artifact or No-save reason")
}

BEGIN {
  section_count = 0
  section_begin = 0
  section_end = 0
  section_open = 0
  checklist_seen = 0
  block_start = 0
}

{
  lines[NR] = $0
  if ($0 == "## Commit checklist") {
    checklist_seen = 1
  }
  if ($0 ~ /^## Persistence obligations([[:space:]]|$)/) {
    if ($0 != "## Persistence obligations") {
      fail("Persistence obligations heading must be exact")
    }
    if (checklist_seen) {
      fail("Persistence obligations must precede Commit checklist")
    }
    section_count++
    if (section_count > 1) {
      fail("active TODO must contain at most one Persistence obligations section")
    }
    section_begin = NR
    section_open = 1
  } else if (section_open && $0 ~ /^## /) {
    section_end = NR
    section_open = 0
  }
}

END {
  if (failed) {
    exit 1
  }
  if (section_open) {
    section_end = NR + 1
  }
  if (section_count == 0) {
    exit 0
  }

  in_section = 0
  for (i = 1; i < section_end; i++) {
    if (i == section_begin) {
      in_section = 1
      continue
    }
    if (!in_section) {
      continue
    }
    if (lines[i] ~ /^###/) {
      if (block_start != 0) {
        validate_block(block_start, i)
      }
      block_start = i
      continue
    }
    if (block_start == 0 && lines[i] ~ /[^[:space:]]/) {
      fail("Persistence obligations contains unexpected content outside an obligation block")
    }
  }
  if (block_start != 0) {
    validate_block(block_start, section_end)
  }
}' "$target"); then
    return 1
  fi

  if [[ -n "$parsed" ]]; then
    while IFS=$'\t' read -r owner destination artifact_target; do
      validate_artifact_evidence "$owner" "$destination" "$artifact_target" || return 1
    done <<<"$parsed"
  fi
}

operation=${1:-}
if [[ "$operation" == "check" ]]; then
  shift
  check_obligations "$@"
  exit $?
fi
[[ "$operation" == "register" || "$operation" == "close" ]] || usage
shift

expected=""
task_key=""
obligation_id=""
owner=""
policy=""
destination=""
no_save_reason=""
artifact=""
has_expected=0
has_id=0
has_owner=0
has_policy=0
has_destination=0
has_no_save_reason=0
has_artifact=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --expect)
      [[ "$has_expected" -eq 0 && $# -ge 2 && -n "$2" ]] || usage
      expected=$2
      has_expected=1
      shift 2
      ;;
    --id)
      [[ "$has_id" -eq 0 && $# -ge 2 && -n "$2" ]] || usage
      obligation_id=$2
      has_id=1
      shift 2
      ;;
    --owner)
      [[ "$has_owner" -eq 0 && $# -ge 2 && -n "$2" ]] || usage
      owner=$2
      has_owner=1
      shift 2
      ;;
    --policy)
      [[ "$has_policy" -eq 0 && $# -ge 2 && -n "$2" ]] || usage
      policy=$2
      has_policy=1
      shift 2
      ;;
    --destination)
      [[ "$has_destination" -eq 0 && $# -ge 2 && -n "$2" ]] || usage
      destination=$2
      has_destination=1
      shift 2
      ;;
    --no-save-reason)
      [[ "$has_no_save_reason" -eq 0 && $# -ge 2 ]] || usage
      no_save_reason=$2
      has_no_save_reason=1
      shift 2
      ;;
    --artifact)
      [[ "$has_artifact" -eq 0 && $# -ge 2 && -n "$2" ]] || usage
      artifact=$2
      has_artifact=1
      shift 2
      ;;
    --*)
      usage
      ;;
    *)
      [[ -z "$task_key" ]] || usage
      task_key=$1
      shift
      ;;
  esac
done

if [[ "$operation" == "register" ]]; then
  [[ "$has_expected" -eq 1 && "$expected" != "missing" ]] || usage
  [[ "$has_id" -eq 1 && "$has_owner" -eq 1 && "$has_policy" -eq 1 ]] || usage
  [[ -n "$task_key" ]] || usage
  [[ "$has_destination" -eq 1 || "$has_no_save_reason" -eq 1 ]] || usage
  [[ "$has_destination" -eq 0 || "$has_no_save_reason" -eq 0 ]] || usage
  [[ "$has_artifact" -eq 0 ]] || usage
else
  [[ "$has_expected" -eq 1 && "$expected" != "missing" ]] || usage
  [[ "$has_id" -eq 1 ]] || usage
  [[ -n "$task_key" ]] || usage
  [[ "$has_owner" -eq 0 && "$has_policy" -eq 0 ]] || usage
  [[ "$has_destination" -eq 0 ]] || usage
  if [[ "$has_artifact" -eq 0 && "$has_no_save_reason" -eq 0 ]] || \
    [[ "$has_artifact" -eq 1 && "$has_no_save_reason" -eq 1 ]]; then
    usage
  fi
fi

if [[ ! "$obligation_id" =~ ^[a-z0-9][a-z0-9._-]*$ ]]; then
  echo "todo-obligation: invalid obligation ID: $obligation_id" >&2
  exit 1
fi

if [[ "$operation" == "register" ]]; then
  case "$owner:$policy" in
    security-audit:required|\
    execute-worktree-implementation:none|\
    test-driven-development:none|\
    context-handoff:conditional|\
    assumption-pruning:none|\
    route-large-implementation:none|\
    evidence-review:none|\
    prose-proofreading:none|\
    peer-consultation:none|\
    herdr:none) ;;
    *)
      echo "todo-obligation: owner and policy are not a canonical pair: $owner/$policy" >&2
      exit 1
      ;;
  esac
fi

trimmed_reason=""
if [[ "$has_no_save_reason" -eq 1 ]]; then
  trimmed_reason=$no_save_reason
  trimmed_reason="${trimmed_reason#"${trimmed_reason%%[![:space:]]*}"}"
  trimmed_reason="${trimmed_reason%"${trimmed_reason##*[![:space:]]}"}"
  if [[ ! "$trimmed_reason" =~ [^[:space:]] ]]; then
    echo "todo-obligation: no-save reason must contain non-whitespace text" >&2
    exit 1
  fi
  if [[ "$trimmed_reason" == *$'\n'* || "$trimmed_reason" == *$'\r'* ]]; then
    echo "todo-obligation: no-save reason must be a single line" >&2
    exit 1
  fi
  reason_lower=$(printf '%s' "$trimmed_reason" | tr '[:upper:]' '[:lower:]')
  case "$reason_lower" in
    n/a|na|none|null|nil|tbd|todo|"no reason"|"not applicable"|なし|"特になし")
      echo "todo-obligation: no-save reason must be concrete" >&2
      exit 1
      ;;
  esac
fi

if [[ "$has_destination" -eq 1 ]]; then
  if [[ "$destination" == *$'\n'* || "$destination" == *$'\r'* || "$destination" == *"\\"* ]]; then
    echo "todo-obligation: destination must be a normalized repository-relative path" >&2
    exit 1
  fi
  if ! is_safe_path "$destination"; then
    echo "todo-obligation: destination contains unsafe path characters" >&2
    exit 1
  fi
  case "$destination" in
    .dev/adr/*|.dev/contexts/*|.dev/designdoc/*|.dev/research/*|.dev/memory/*|.dev/security/*) ;;
    *)
      echo "todo-obligation: destination must be under a canonical .dev area: $destination" >&2
      exit 1
      ;;
  esac

  remaining=$destination
  while [[ "$remaining" == */* ]]; do
    segment=${remaining%%/*}
    remaining=${remaining#*/}
    [[ -n "$segment" && "$segment" != "." && "$segment" != ".." ]] || {
      echo "todo-obligation: destination contains an invalid path segment: $destination" >&2
      exit 1
    }
  done
  [[ -n "$remaining" && "$remaining" != "." && "$remaining" != ".." ]] || {
    echo "todo-obligation: destination contains an invalid path segment: $destination" >&2
    exit 1
  }

  case "$owner" in
    security-audit)
      [[ "$destination" == .dev/security/* ]] || {
        echo "todo-obligation: security-audit destinations must be under .dev/security/" >&2
        exit 1
      }
      ;;
    context-handoff)
      [[ "$destination" == .dev/contexts/* ]] || {
        echo "todo-obligation: $owner destinations must be under .dev/contexts/" >&2
        exit 1
      }
      ;;
  esac
fi

if [[ "$policy" == required && "$has_destination" -ne 1 ]]; then
  echo "todo-obligation: required obligations need a destination" >&2
  exit 1
fi
if [[ "$policy" == none && "$has_no_save_reason" -ne 1 ]]; then
  echo "todo-obligation: none obligations need a concrete no-save reason" >&2
  exit 1
fi

if [[ "$operation" == "close" && "$has_artifact" -eq 1 ]]; then
  if [[ "$artifact" == *$'\n'* || "$artifact" == *$'\r'* || "$artifact" == *"\\"* ]]; then
    echo "todo-obligation: artifact must be a normalized repository-relative path" >&2
    exit 1
  fi
  if ! is_safe_path "$artifact"; then
    echo "todo-obligation: artifact contains unsafe path characters" >&2
    exit 1
  fi
  case "$artifact" in
    /*|*://*|.dev/todo|.dev/todo/*)
      echo "todo-obligation: artifact must stay in the current worktree outside .dev/todo: $artifact" >&2
      exit 1
      ;;
    .dev/*) ;;
    *)
      echo "todo-obligation: artifact must be repository-relative under .dev: $artifact" >&2
      exit 1
      ;;
  esac

  remaining=$artifact
  while [[ "$remaining" == */* ]]; do
    segment=${remaining%%/*}
    remaining=${remaining#*/}
    [[ -n "$segment" && "$segment" != "." && "$segment" != ".." ]] || {
      echo "todo-obligation: artifact contains an invalid path segment: $artifact" >&2
      exit 1
    }
  done
  [[ -n "$remaining" && "$remaining" != "." && "$remaining" != ".." ]] || {
    echo "todo-obligation: artifact contains an invalid path segment: $artifact" >&2
    exit 1
  }

  current_worktree=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "todo-obligation: not inside a Git worktree" >&2
    exit 1
  }
  current_worktree=$(cd "$current_worktree" && pwd -P)
  walk_path=$current_worktree
  remaining=$artifact
  while [[ "$remaining" == */* ]]; do
    segment=${remaining%%/*}
    remaining=${remaining#*/}
    walk_path="$walk_path/$segment"
    [[ ! -L "$walk_path" ]] || {
      echo "todo-obligation: artifact path must not traverse a symlink: $artifact" >&2
      exit 1
    }
  done
  walk_path="$walk_path/$remaining"
  if [[ -L "$walk_path" || ! -f "$walk_path" ]]; then
    echo "todo-obligation: artifact must be an existing regular non-symlink file: $artifact" >&2
    exit 1
  fi
fi

script_dir=$(cd "$(dirname "$0")" && pwd -P)
target=$("$script_dir/todo-path" "$task_key")
if [[ -L "$target" || ! -f "$target" ]]; then
  echo "todo-obligation: active TODO must be a regular file: $target" >&2
  exit 1
fi

transformed=""
# shellcheck disable=SC2329  # Invoked by the trap below.
cleanup() {
  if [[ -n "$transformed" && -e "$transformed" ]]; then
    rm -f -- "$transformed"
  fi
}
trap cleanup EXIT HUP INT TERM

transformed=$(mktemp "$target.obligation.XXXXXX")
if [[ "$operation" == "register" ]]; then
  new_state=open
  if [[ "$has_no_save_reason" -eq 1 ]]; then
    new_state=closed
  fi

  if ! awk \
  -v new_id="$obligation_id" \
  -v new_owner="$owner" \
  -v new_policy="$policy" \
  -v new_state="$new_state" \
  -v new_destination="$destination" \
  -v new_reason="$trimmed_reason" '
function emit_entry() {
  if (last_line != "") {
    print ""
  }
  printf "### `%s`\n", new_id
  printf "- Owner: `%s`\n", new_owner
  printf "- Policy: `%s`\n", new_policy
  printf "- State: `%s`\n", new_state
  if (new_destination != "") {
    printf "- Destination: `%s`\n", new_destination
  } else {
    printf "- No-save reason: %s\n", new_reason
  }
  print ""
}

function emit_new_section() {
  if (last_line != "") {
    print ""
  }
  print "## Persistence obligations"
  print ""
  last_line = ""
  emit_entry()
}

BEGIN {
  in_obligations = 0
  section_count = 0
  checklist_seen = 0
  entry_inserted = 0
  last_line = ""
}

{
  line = $0
  if (line == "## Commit checklist") {
    checklist_seen = 1
  }
  if (line == "## Persistence obligations") {
    if (checklist_seen) {
      exit 1
    }
    section_count++
    if (section_count > 1) {
      exit 1
    }
    in_obligations = 1
  } else if (in_obligations && line ~ /^## /) {
    if (!entry_inserted) {
      emit_entry()
      entry_inserted = 1
    }
    in_obligations = 0
  }

  if (in_obligations && line ~ /^### /) {
    if (line !~ /^### `[a-z0-9][a-z0-9._-]*`$/) {
      exit 1
    }
    existing_id = line
    sub(/^### `/, "", existing_id)
    sub(/`$/, "", existing_id)
    if (existing_id == new_id || (existing_id in seen_ids)) {
      exit 1
    }
    seen_ids[existing_id] = 1
  }

  if (!in_obligations && section_count == 0 && line == "## Commit checklist") {
    emit_new_section()
    entry_inserted = 1
  }
  print line
  last_line = line
}

END {
  if (section_count == 0 && !checklist_seen) {
    exit 1
  }
  if (section_count > 0 && !entry_inserted) {
    emit_entry()
  }
}' \
  "$target" >"$transformed"; then
  echo "todo-obligation: active TODO has no valid persistence-obligation insertion point" >&2
  exit 5
fi
else
  artifact_link="../${artifact#.dev/}"
  close_mode=artifact
  if [[ "$has_no_save_reason" -eq 1 ]]; then
    close_mode=no-save
  fi
  if ! TODO_OBLIGATION_CLOSE_REASON="$trimmed_reason" awk \
    -v close_id="$obligation_id" \
    -v artifact="$artifact" \
    -v artifact_link="$artifact_link" \
    -v close_mode="$close_mode" '
function fail(message) {
  print "todo-obligation: " message > "/dev/stderr"
  exit 1
}

function canonical_pair(owner, policy) {
  return (owner == "security-audit" && policy == "required") ||
    (owner == "execute-worktree-implementation" && policy == "none") ||
    (owner == "test-driven-development" && policy == "none") ||
    (owner == "context-handoff" && policy == "conditional") ||
    (owner == "assumption-pruning" && policy == "none") ||
    (owner == "route-large-implementation" && policy == "none") ||
    (owner == "evidence-review" && policy == "none") ||
    (owner == "prose-proofreading" && policy == "none") ||
    (owner == "peer-consultation" && policy == "none") ||
    (owner == "herdr" && policy == "none")
}

function validate_target_block(start, end,    count, body, owner, policy, state, destination_line, i, line) {
  count = 0
  for (i = start + 1; i < end; i++) {
    line = lines[i]
    if (line == "") {
      continue
    }
    count++
    body[count] = line
    if (line == "- State: `open`") {
      target_state_line = i
    }
    if (line ~ /^- Destination: `[^`]+`$/) {
      target_destination_line = i
    }
  }
  if (count != 4) {
    fail("obligation block must contain exactly Owner, Policy, State, and Destination fields")
  }

  owner = body[1]
  policy = body[2]
  state = body[3]
  destination_line = body[4]
  if (owner !~ /^- Owner: `[^`]+`$/ || policy !~ /^- Policy: `[^`]+`$/ ||
      state != "- State: `open`") {
    fail("obligation block must use canonical open Owner/Policy/State/Destination fields")
  }
  sub(/^- Owner: `/, "", owner)
  sub(/`$/, "", owner)
  sub(/^- Policy: `/, "", policy)
  sub(/`$/, "", policy)
  if (!canonical_pair(owner, policy) || (policy != "required" && policy != "conditional")) {
    fail("obligation block has a non-canonical owner-policy pair")
  }
  if (close_mode == "no-save" && policy != "conditional") {
    fail("no-save closure requires a conditional obligation")
  }
  if (close_mode == "artifact" && destination_line != "- Destination: `" artifact "`") {
    fail("obligation block destination must match the artifact")
  }
  if (owner == "security-audit" && destination_line !~ /^- Destination: `\.dev\/security\/[^`]+`$/) {
    fail("security-audit obligation destination is outside .dev/security/")
  }
  if (owner == "context-handoff" && destination_line !~ /^- Destination: `\.dev\/contexts\/[^`]+`$/) {
    fail(owner " obligation destination is outside .dev/contexts/")
  }
}

BEGIN {
  section_count = 0
  section_begin = 0
  section_end = 0
  section_open = 0
  checklist_seen = 0
  target_count = 0
  close_reason = ENVIRON["TODO_OBLIGATION_CLOSE_REASON"]
}

{
  lines[NR] = $0
  if ($0 == "## Commit checklist") {
    checklist_seen = 1
  }
  if ($0 == "## Persistence obligations") {
    if (checklist_seen) {
      fail("Persistence obligations must precede Commit checklist")
    }
    section_count++
    if (section_count > 1) {
      fail("active TODO must contain at most one Persistence obligations section")
    }
    section_begin = NR
    section_open = 1
  } else if (section_open && $0 ~ /^## /) {
    section_end = NR
    section_open = 0
  }
}

END {
  if (section_open) {
    section_end = NR + 1
  }
  if (section_count != 1) {
    fail("active TODO must contain one Persistence obligations section for closure")
  }

  in_section = 0
  for (i = 1; i <= NR; i++) {
    if (i == section_begin) {
      in_section = 1
    }
    if (i == section_end) {
      in_section = 0
    }
    if (!in_section || lines[i] !~ /^### /) {
      continue
    }
    heading = lines[i]
    if (heading !~ /^### `[a-z0-9][a-z0-9._-]*`$/) {
      fail("Persistence obligations contains a non-canonical obligation heading")
    }
    heading_id = heading
    sub(/^### `/, "", heading_id)
    sub(/`$/, "", heading_id)
    block_end = i + 1
    while (block_end < section_end && lines[block_end] !~ /^### /) {
      block_end++
    }
    if (heading_id == close_id) {
      target_count++
      if (target_count > 1) {
        fail("the requested obligation ID must occur exactly once")
      }
      target_start = i
      target_end = block_end
      validate_target_block(target_start, target_end)
    }
    i = block_end - 1
  }
  if (target_count != 1) {
    fail("the requested obligation ID must occur exactly once")
  }

  for (i = 1; i <= NR; i++) {
    if (i == target_state_line) {
      print "- State: `closed`"
    } else if (i == target_destination_line) {
      if (close_mode == "artifact") {
        print lines[i]
        print "- Artifact: [" artifact "](" artifact_link ")"
      } else {
        print "- No-save reason: " close_reason
      }
    } else {
      print lines[i]
    }
  }
}' \
    "$target" >"$transformed"; then
    echo "todo-obligation: active TODO obligation closure validation failed" >&2
    exit 5
  fi
fi

writer="$script_dir/../../using-workflow-skills/scripts/workflow-state-write"
if cat "$transformed" | "$writer" --expect "$expected" "$target"; then
  exit 0
else
  status=$?
  exit "$status"
fi
