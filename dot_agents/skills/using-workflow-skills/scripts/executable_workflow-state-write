#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: workflow-state-write [--delete] [--expect HASH|missing] ABSOLUTE_TARGET" >&2
  exit 2
}

expected=""
delete=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --delete)
      [[ "$delete" -eq 0 ]] || usage
      delete=1
      shift
      ;;
    --expect)
      [[ -z "$expected" && $# -ge 2 && -n "$2" ]] || usage
      expected=$2
      shift 2
      ;;
    *) break ;;
  esac
done
[[ $# -eq 1 && "$1" == /* ]] || usage
if [[ "$delete" -eq 1 && ( -z "$expected" || "$expected" == "missing" ) ]]; then
  usage
fi
target=$1

script_dir=$(cd "$(dirname "$0")" && pwd -P)
repository_state=$("$script_dir/workflow-state-root" --ensure)
contexts_dir="$repository_state/contexts"
security_dir="$repository_state/security"
reports_dir="$security_dir/reports"
current_worktree=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "workflow-state-write: not inside a Git worktree" >&2
  exit 1
}
current_worktree=$(cd "$current_worktree" && pwd -P)
current_todo_dir="$current_worktree/.dev/todo"
is_todo=0

target_dir=$(dirname "$target")
target_name=$(basename "$target")
target_dir=$(cd "$target_dir" && pwd -P)
case "$target_dir" in
  "$contexts_dir"|"$reports_dir") ;;
  "$security_dir") [[ "$target_name" == "coverage.md" ]] || usage ;;
  "$current_todo_dir")
    [[ "$repository_state" == "$current_worktree/.dev" ]] || usage
    [[ "$target_name" =~ ^[a-z0-9][a-z0-9._-]*\.md$ ]] || usage
    is_todo=1
    ;;
  *) usage ;;
esac
[[ "$delete" -eq 0 || "$is_todo" -eq 1 ]] || usage
if [[ "$is_todo" -eq 1 && -z "$expected" ]]; then
  echo "workflow-state-write: active TODO writes require --expect" >&2
  exit 2
fi
[[ "$target_name" != "." && "$target_name" != ".." ]] || usage

validate_target_type() {
  if [[ -L "$target" || -d "$target" || ( -e "$target" && ! -f "$target" ) ]]; then
    echo "workflow-state-write: target must be a regular file or missing: $target" >&2
    exit 2
  fi
}
validate_target_type

lock_dir="$target.lock"
if ! mkdir -- "$lock_dir" 2>/dev/null; then
  echo "workflow-state-write: record is locked: $target" >&2
  exit 3
fi

temp_file=""
cleanup() {
  if [[ -n "$temp_file" && -e "$temp_file" ]]; then
    rm -f -- "$temp_file"
  fi
  rmdir -- "$lock_dir" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

if [[ -n "$expected" ]]; then
  if [[ -f "$target" ]]; then
    current=$(git hash-object --no-filters "$target")
  else
    current=missing
  fi
  if [[ "$current" != "$expected" ]]; then
    echo "workflow-state-write: record changed (expected $expected, found $current)" >&2
    exit 4
  fi
fi

if [[ "$delete" -eq 1 ]]; then
  validate_target_type
  [[ -f "$target" ]] || {
    echo "workflow-state-write: cannot delete a missing record: $target" >&2
    exit 4
  }
  rm -- "$target"
  exit 0
fi

umask 077
temp_file=$(mktemp "$target.tmp.XXXXXX")
cat >"$temp_file"
chmod 600 "$temp_file"
validate_target_type
mv -f -- "$temp_file" "$target"
temp_file=""
