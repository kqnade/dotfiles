#!/usr/bin/env bash

set -euo pipefail

authorize_repository() {
  local remotes status remote_url
  if git config --get-all remote.origin.url >/dev/null; then
    if ! remotes="$(git remote get-url --all origin)"; then
      printf '%s\n' 'Cannot resolve the Pi repository origin; refusing to start.' >&2
      return 1
    fi
  else
    status=$?
    # No origin is normal for non-repository work and new personal repositories.
    if [[ "$status" -eq 1 ]]; then
      return 0
    fi
    printf '%s\n' 'Cannot check the Pi repository origin; refusing to start.' >&2
    return 1
  fi

  while IFS= read -r remote_url; do
    remote_url="$(printf '%s' "$remote_url" | tr '[:upper:]' '[:lower:]')"
    if [[ "$remote_url" =~ ^((ssh|https?|git)://([^/@]+@)?github\.com(:[0-9]+)?/|([^/@:]+@)?github\.com:)(livesense-inc|jobtalk)/ ]]; then
      printf '%s\n' 'Pi is not authorized for livesense-inc or jobtalk repositories; use the approved Claude account.' >&2
      return 2
    fi
  done <<<"$remotes"
}

# Check before credential lookup, telemetry opt-out, and every Pi invocation.
authorize_repository

runtime_config="$HOME/.config/dotfiles/client-runtime.sh"
if [[ ! -r "$runtime_config" ]]; then
  printf '%s\n' 'Client runtime configuration is missing; apply the managed dotfiles first.' >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$runtime_config"
dotfiles_client_environment

run_pi() {
  local pi_bin
  if ! pi_bin="$(command -v pi 2>/dev/null)"; then
    printf '%s\n' 'Pi coding agent is not installed.' >&2
    exit 127
  fi
  unset NEW_RELIC_LICENSE_KEY
  exec "$pi_bin" "$@"
}

telemetry_enabled="${PI_NEW_RELIC_ENABLE:-1}"
telemetry_enabled_lower="$(printf '%s' "$telemetry_enabled" | tr '[:upper:]' '[:lower:]')"
case "$telemetry_enabled_lower" in
  0 | false | no | off | disabled)
    run_pi "$@"
    ;;
  *)
    telemetry_enabled="1"
    ;;
esac

case "${1:-}" in
  -h | --help | -v | --version | install | remove | uninstall | update | list | config | auth)
    run_pi "$@"
    ;;
esac

license_key="${PI_NEW_RELIC_API_KEY:-${NEW_RELIC_LICENSE_KEY:-}}"
if [[ -z "$license_key" ]]; then
  if ! op_bin="$(command -v op 2>/dev/null)"; then
    printf '%s\n' 'Pi telemetry requires 1Password CLI or PI_NEW_RELIC_API_KEY.' >&2
    exit 1
  fi
  op_ref="$NEW_RELIC_LICENSE_KEY_OP_REF"
  [[ "$op_ref" == op://* ]] || {
    printf '%s\n' 'New Relic 1Password reference is missing or invalid.' >&2
    exit 1
  }
  if ! license_key="$("$op_bin" read "$op_ref")"; then
    printf '%s\n' 'Failed to read the New Relic license key from 1Password.' >&2
    exit 1
  fi
fi
if [[ -z "$license_key" ]]; then
  printf '%s\n' 'New Relic license key is empty.' >&2
  exit 1
fi

export PI_NEW_RELIC_ENABLE="$telemetry_enabled"
export PI_NEW_RELIC_API_KEY="$license_key"
unset NEW_RELIC_LICENSE_KEY
run_pi "$@"
