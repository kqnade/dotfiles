#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf '%s\n' 'Usage: dsh personal|work [web [--no-open] | TUI options]; dsh personal login' \
    'Personal: Codex subscription and Ollama. Work: Ollama and Claude Code subagent.'
}

case "${1:-}" in
  personal | work)
    role="$1"
    shift
    ;;
  -h | --help | '')
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

if [[ "$role" == work ]]; then
  if [[ "$(uname -s)" != Darwin ]]; then
    echo 'Work Harness requires Darwin.' >&2
    exit 2
  fi
  runtime_config="$HOME/.config/dotfiles/client-runtime.sh"
  unset DOTFILES_DSH_WORK_ENABLED
  if [[ ! -r "$runtime_config" ]]; then
    echo 'Work Harness runtime configuration is missing; apply the managed dotfiles first.' >&2
    exit 2
  fi
  # shellcheck source=/dev/null
  source "$runtime_config"
  if [[ "${DOTFILES_DSH_WORK_ENABLED:-}" != true ]]; then
    echo 'Work Harness is disabled; enable dsh_work_enabled in the local chezmoi configuration and apply.' >&2
    exit 2
  fi
fi

surface=tui
if [[ "${1:-}" == web ]]; then
  surface=web
  shift
fi

# The outer CLI can replace the composition; expose only surface-specific arguments.
validate_arguments() {
  local option
  if [[ "$surface" == web ]]; then
    for option in "$@"; do
      case "$option" in
        --no-open | -h | --help) ;;
        *)
          echo "Unsupported managed Web argument: $option" >&2
          return 2
          ;;
      esac
    done
    return 0
  fi
  while [[ $# -gt 0 ]]; do
    option="$1"
    shift
    case "$option" in
      --new | --no-color | --no-bell | --profiling | -h | --help | list-models) continue ;;
      --resume)
        if [[ $# -gt 0 && "$1" != -* ]]; then shift; fi
        continue
        ;;
      --resume=*) continue ;;
      --preset)
        [[ $# -gt 0 && "$1" != -* ]] || {
          echo "$option requires a value." >&2
          return 2
        }
        shift
        ;;
      --preset=*) ;;
      --model | --model=* | --provider | --provider=*)
        echo 'Select the provider and model with /model inside the TUI.' >&2
        return 2
        ;;
      *)
        echo "Unsupported managed TUI argument: $option" >&2
        return 2
        ;;
    esac
  done
}
login=false
if [[ "$role" == personal && "$surface" == tui && "${1:-}" == login && $# -eq 1 ]]; then
  login=true
else
  validate_arguments "$@"
fi

authorize_repository() {
  local remotes status url work_origin
  if git config --get-all remote.origin.url >/dev/null; then
    remotes="$(git remote get-url --all origin)" || return 1
  else
    status=$?
    if [[ "$status" -eq 1 && "$role" == personal ]]; then return 0; fi
    echo "Cannot authorize $role Harness without a readable repository origin." >&2
    return 2
  fi
  while IFS= read -r url; do
    url="$(printf '%s' "$url" | tr '[:upper:]' '[:lower:]')"
    work_origin=false
    if [[ "$url" =~ ^((ssh|https?|git)://([^/@]+@)?github\.com(:[0-9]+)?/|([^/@:]+@)?github\.com:)(livesense-inc|jobtalk)/[^/]+/?$ ]]; then
      work_origin=true
    fi
    if [[ "$role" == personal && "$work_origin" == true ]]; then
      echo 'Use dsh work in livesense-inc and jobtalk repositories.' >&2
      return 2
    fi
    if [[ "$role" == work && "$work_origin" != true ]]; then
      echo 'Work Harness is authorized only for livesense-inc and jobtalk repositories.' >&2
      return 2
    fi
  done <<<"$remotes"
}
# Work Web authorizes workspace additions in its server-side plugin.
if [[ "$role" != work || "$surface" != web ]]; then
  authorize_repository
fi

export DSH_HOME="$HOME/.dsh/$role"
export DSH_OLLAMA_API_KEY=ollama
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN CLAUDE_API_KEY
unset OPENAI_API_KEY OPENAI_ACCESS_TOKEN DEEPSEEK_API_KEY CLAUDE_CONFIG_DIR
if [[ "$role" == personal ]]; then
  export CLAUDE_CONFIG_DIR="$DSH_HOME/claude-disabled"
fi
dsh_bin="$DSH_HOME/profiles/$surface/node_modules/.bin/dsh"
if [[ ! -x "$dsh_bin" ]]; then
  echo 'Harness profile dependencies are missing; run mise run dsh-setup.' >&2
  exit 1
fi
configure_telemetry() {
  local enabled key runtime_config op_ref option
  enabled="$(printf '%s' "${DSH_NEW_RELIC_ENABLE:-1}" | tr '[:upper:]' '[:lower:]')"
  case "$enabled" in 0 | false | no | off | disabled) enabled=0 ;; *) enabled=1 ;; esac
  if [[ "$login" == true ]]; then enabled=0; fi
  for option in "$@"; do
    case "$option" in -h | --help | list-models) enabled=0 ;; esac
  done
  if [[ "$enabled" == 0 ]]; then
    export DSH_NEW_RELIC_ENABLE=0
    unset DSH_NEW_RELIC_API_KEY
    return
  fi
  key="${DSH_NEW_RELIC_API_KEY:-${NEW_RELIC_LICENSE_KEY:-}}"
  if [[ -z "$key" ]]; then
    runtime_config="$HOME/.config/dotfiles/client-runtime.sh"
    if [[ ! -r "$runtime_config" ]]; then
      echo 'New Relic runtime configuration is missing; apply the managed dotfiles first.' >&2
      return 1
    fi
    # shellcheck source=/dev/null
    source "$runtime_config"
    op_ref="${NEW_RELIC_LICENSE_KEY_OP_REF:-$DOTFILES_OP_NEW_RELIC_REF}"
    if [[ "$op_ref" != op://* ]] || ! key="$(op read "$op_ref")"; then
      echo 'Failed to read the New Relic license key from 1Password.' >&2
      return 1
    fi
  fi
  if [[ -z "${key//[[:space:]]/}" ]]; then
    echo 'New Relic license key is empty.' >&2
    return 1
  fi
  export DSH_NEW_RELIC_ENABLE=1 DSH_NEW_RELIC_API_KEY="$key"
}
configure_telemetry "$@"
if [[ "$login" == true ]]; then
  exec "$DSH_HOME/profiles/tui/node_modules/.bin/dsh-provider-extra-login"
fi
if [[ "$surface" == web ]]; then
  port=3080
  if [[ "$role" == work ]]; then port=3081; fi
  set -- --host 127.0.0.1 --port "$port" "$@"
  if [[ "$role" == work ]]; then
    set -- --patch "$HOME/.config/deepseek-harness/work/web-required.patch.yml" "$@"
  fi
  exec "$dsh_bin" --profile web "$@"
fi
exec "$dsh_bin" --profile tui "$@"
