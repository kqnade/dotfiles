{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoMemoryEnabled": false,
  "awaySummaryEnabled": false,
  "cleanupPeriodDays": 14,
  "disableArtifact": true,
  "disableClaudeAiConnectors": true,
  "editorMode": "normal",
  "effortLevel": "high",
  "enabledPlugins": {
    "datadog@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notify.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/format-on-save.sh",
            "statusMessage": "Formatting...",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/authorize-repository.sh",
            "statusMessage": "Checking Claude repository authorization...",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/protect-files.sh",
            "statusMessage": "Checking file protections...",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/warn-large-files.sh",
            "statusMessage": "Checking for build artifacts...",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/scan-secrets.sh",
            "statusMessage": "Scanning for secrets...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/block-dangerous-commands.sh",
            "statusMessage": "Checking command safety...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/session-start.sh",
            "statusMessage": "Loading project context...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      },
      {
        "hooks": [
          {
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/authorize-repository.sh",
            "statusMessage": "Checking Claude repository authorization...",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "language": "Japanese",
  "model": "opus[1m]",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(cargo *)",
      "Bash(go *)",
      "Bash(zig *)",
      "Bash(npm *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git -c *)",
      "Bash(git add .)",
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(git add -u *)",
      "Bash(git commit --amend *)",
      "Bash(git commit -a *)",
      "Bash(git commit --all *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D *)",
      "Bash(git push *)",
      "Bash(git lfs push *)",
      "Bash(git lfs lock *)",
      "Bash(git lfs unlock *)",
      "Bash(git send-email *)",
      "Bash(git svn dcommit *)",
      "Bash(git p4 submit *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr review *)",
      "Bash(gh * cancel *)",
      "Bash(gh * close *)",
      "Bash(gh * comment *)",
      "Bash(gh * create *)",
      "Bash(gh * delete *)",
      "Bash(gh * edit *)",
      "Bash(gh * merge *)",
      "Bash(gh * reopen *)",
      "Bash(gh * rerun *)",
      "Bash(gh * run *)",
      "Bash(gh * set *)",
      "Bash(gh * submit *)",
      "Bash(gh * upload *)",
      "Bash(gh api *)",
      "Bash(npm publish *)",
      "Bash(npm unpublish *)",
      "Bash(npm deprecate *)",
      "Bash(npm dist-tag *)",
      "Bash(npm owner *)",
      "Bash(npm access *)",
      "Bash(npm token *)",
      "Bash(npm login *)",
      "Bash(npm logout *)",
      "Bash(npm adduser *)",
      "Bash(npm config set *)",
      "Bash(npm install -g *)",
      "Bash(npm install --global *)",
      "Bash(cargo publish *)",
      "Bash(cargo yank *)",
      "Bash(cargo owner *)",
      "Bash(cargo login *)",
      "Bash(cargo install *)",
      "Bash(cargo uninstall *)",
      "Bash(go env -w *)",
      "Bash(go install *)",
      "mcp__plugin_github_github__*write*",
      "mcp__plugin_github_github__add_*",
      "mcp__plugin_github_github__create_*",
      "mcp__plugin_github_github__delete_*",
      "mcp__plugin_github_github__fork_*",
      "mcp__plugin_github_github__merge_*",
      "mcp__plugin_github_github__push_*",
      "mcp__plugin_github_github__request_*",
      "mcp__plugin_github_github__submit_*",
      "mcp__plugin_github_github__update_*"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)"
    ]
  },
  "preferredNotifChannel": "notifications_disabled",
  "promptSuggestionEnabled": false,
  "remoteControlAtStartup": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "bunx -y ccstatusline@2.2.23",
    "padding": 0,
    "type": "command"
  },
  "theme": "dark-daltonize",
  "verbose": true
}{{- /* Herdr's Claude integration writes JSON without a trailing newline. */ -}}
